{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glide Dock",
  "version": "0.6.0",
  "identifier": "app.glidedock",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "bar",
        "url": "bar.html",
        "title": "Glide Dock",
        "width": 1200,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "shortDescription": "Lightweight smart dock and taskbar for Windows",
    "copyright": "MIT License",
    "category": "Utility"
  }
}